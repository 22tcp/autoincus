---
[Unit]
Description=Redis Sentinel {{ inventory_hostname }}
Documentation=https://redis.io/docs/manual/sentinel/
After=network.target redis-server.service
Wants=network.target
BindsTo=redis-server.service

[Service]
Type=forking
User={{ redis_cluster_owner }}
Group={{ redis_cluster_group }}

ExecStart={{ redis_cluster_bin_dir }}/redis-sentinel {{ redis_cluster_config_dir }}/sentinel.conf
ExecStop={{ redis_cluster_bin_dir }}/redis-cli -p {{ redis_cluster_sentinel_port }} shutdown

PIDFile={{ redis_cluster_pid_dir }}/redis-sentinel.pid
RuntimeDirectory=redis
RuntimeDirectoryMode=0755

# Restart behaviour
Restart=on-failure
RestartSec={{ redis_cluster_service_restart_sec }}
TimeoutStopSec=30

# Hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
